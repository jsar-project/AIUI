.page {
  display: flex;
  flex-direction: column;
  gap: 14px;
  padding: 16px;
}

.title {
  font-size: 24px;
  font-weight: bold;
}

.subtitle,
.line,
.switch-label,
.snapshot-text,
.placeholder-text,
.inline-code {
  font-size: 13px;
}

.section {
  display: flex;
  flex-direction: column;
  gap: 10px;
  padding: 14px;
  border-width: 1px;
  border-radius: 14px;
}

.section-title {
  font-size: 17px;
  font-weight: bold;
}

.button-row {
  display: flex;
  flex-direction: row;
  gap: 10px;
}

.action {
  flex: 1;
}

.action-secondary {
  width: 100%;
}

.switch-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.snapshot-row,
.panel-list,
.panel-item,
.placeholder,
.slot-meta {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.inline-code {
  font-family: monospace;
}

.slot-map {
  width: 100%;
  height: 240px;
  border-width: 1px;
  border-radius: 14px;
  overflow: hidden;
}

.named-slot-panel,
.slot-panel-content {
  display: flex;
  flex-direction: column;
}

.slot-panel-content {
  gap: 8px;
}

.slot-panel-title {
  font-size: 18px;
  font-weight: bold;
}
